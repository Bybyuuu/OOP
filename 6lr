class StudioExamplesPage(QWidget):
    def __init__(self, stacked_widget):
        super().__init__()
        self.stacked_widget = stacked_widget
        self.init_ui()

    def init_ui(self):
        layout = QVBoxLayout()
        layout.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.image_label = QLabel()
        self.image_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        
        self.room_label = QLabel()
        self.room_label.setFont(QFont("Arial", 24, QFont.Weight.Bold))
        self.room_label.setStyleSheet("color: white;")
        self.room_label.setAlignment(Qt.AlignmentFlag.AlignCenter)

        self.images = [
            ("https://sun9-59.userapi.com/impg/B5z9cS4h_KvmLkj4mqPzELRhMMgCYKV17LhM0g/IcEsXzTkZoM.jpg?size=1800x1200&quality=95&sign=d8334407bb812fcc8592cc0e4d4c43fb&type=album", "Зал 1"),
            ("https://avatars.mds.yandex.net/get-altay/11873493/2a00000193304c4dc9c2cd459f314d5f8127/XXL_height", "Зал 2"),
            ("https://sun9-73.userapi.com/impg/SeR7sWllZkc-UTst24t4ez-bvF7tuIunfx-qMA/RaYcA7OhBO4.jpg?size=1800x1200&quality=95&sign=e00ca738d75aeaf65fce9806bb31651d&type=album", "Зал 3"),
            ("https://pp.userapi.com/c847221/v847221194/104395/jp2w2Vg0n1s.jpg", "VIP Зал")  
        ]
        self.current_image_index = 0
        self.update_image()

        next_btn = QPushButton("Следующий зал")
        prev_btn = QPushButton("Предыдущий зал")
        back_btn = QPushButton("Назад")

        next_btn.setFont(QFont("Arial", 18))
        prev_btn.setFont(QFont("Arial", 18))
        back_btn.setFont(QFont("Arial", 18))

        next_btn.setStyleSheet("background-color: white; color: black; padding: 10px 20px; font-size: 20px; border-radius: 10px;")
        prev_btn.setStyleSheet("background-color: white; color: black; padding: 10px 20px; font-size: 20px; border-radius: 10px;")
        back_btn.setStyleSheet("background-color: white; color: black; padding: 10px 20px; font-size: 20px; border-radius: 10px;")

        next_btn.clicked.connect(self.next_image)
        prev_btn.clicked.connect(self.prev_image)
        back_btn.clicked.connect(lambda: self.stacked_widget.setCurrentIndex(1))

        layout.addWidget(self.room_label)
        layout.addWidget(self.image_label)
        layout.addWidget(prev_btn)
        layout.addWidget(next_btn)
        layout.addWidget(back_btn)
        self.setLayout(layout)
        self.setStyleSheet("background-color: #6B0300;")

    def update_image(self):
        image_url, room_name = self.images[self.current_image_index]
        self.room_label.setText(room_name)
        image_url = QUrl(image_url)
        pixmap = QPixmap()
        pixmap.loadFromData(self.download_image(image_url))
        self.image_label.setPixmap(pixmap.scaled(400, 300, Qt.AspectRatioMode.KeepAspectRatio))

    def download_image(self, image_url: QUrl):
        manager = QNetworkAccessManager(self)
        request = QNetworkRequest(image_url)
        reply = manager.get(request)
        reply.finished.connect(lambda: self.on_image_downloaded(reply))
        return reply.readAll()

    def on_image_downloaded(self, reply):
        data = reply.readAll()
        self.update_image_with_data(data)

    def update_image_with_data(self, data):
        pixmap = QPixmap()
        pixmap.loadFromData(data)
        self.image_label.setPixmap(pixmap.scaled(400, 300, Qt.AspectRatioMode.KeepAspectRatio))

    def next_image(self):
        self.current_image_index = (self.current_image_index + 1) % len(self.images)
        self.update_image()

    def prev_image(self):
        self.current_image_index = (self.current_image_index - 1) % len(self.images)
        self.update_image()

class MainApp(QWidget):
